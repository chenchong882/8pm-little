            "grammar": {
                "tips": [
                    {
                        "label": "基本句型-單數",
                        "text": "Whose + 單數名詞 + is it?"
                    },
                    {
                        "label": "基本句型-複數",
                        "text": "Whose + 複數名詞 + are they?"
                    },
                    {
                        "label": "回答方式-單數",
                        "text": "It is + 所有格 (名詞's / 所有格形容詞) + 單數名詞."
                    },
                    {
                        "label": "回答方式-複數",
                        "text": "They are + 所有格 (名詞's / 所有格形容詞) + 複數名詞."
                    }
                ],
                "notes": [
                    {
                        "title": "所有格疑問詞 Whose 的用法",
                        "rule": "Whose 用於詢問物品的所有權歸屬。",
                        "description": "Whose 置於句首，後方必須緊接所詢問的名詞。根據物品的單複數，動詞與代名詞需做相應調整。",
                        "examples": [
                            "Whose jacket is it?",
                            "Whose glasses are they?"
                        ]
                    },
                    {
                        "title": "所有格名詞與所有格形容詞",
                        "rule": "名詞字尾加 's 或使用所有格形容詞。",
                        "description": "人名後加 's (如 Kevin's) 表所有權。常用所有格形容詞包括 my, your, his, her 等。不可漏掉名詞。",
                        "examples": [
                            "It's Kevin's jacket.",
                            "They're my glasses."
                        ]
                    },
                    {
                        "title": "特殊名詞：恆為複數的名詞",
                        "rule": "glasses (眼鏡) 恆為複數型態。",
                        "description": "眼鏡因有兩個鏡片，在英文語法中被視為複數，詢問時須搭配 are 與 they，不可使用 is 或 it。",
                        "examples": [
                            "Whose glasses are they?",
                            "They are my glasses."
                        ]
                    }
                ],
